# Supabase (the app falls back to the bundled CSV dataset when absent)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only secret key: used by API routes and the seed script, bypasses RLS.
SUPABASE_SECRET_KEY=

# Anthropic — powers the AI analyst agent
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-4-8
ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini — powers the image generation tool
GEMINI_API_KEY=
# Optional override, defaults to gemini-3-pro-image
GEMINI_IMAGE_MODEL=gemini-3-pro-image
